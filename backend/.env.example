# =============================================================================
# Modelo de variáveis de ambiente do Rails — copie para `.env` e preencha.
# O arquivo `.env` NÃO deve ser commitado (está no .gitignore).
# =============================================================================

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
POSTGRES_DB=antecipe_development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ----- Aplicação -----
RAILS_MAX_THREADS=5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
