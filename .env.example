# =============================================================================
# Modelo de variáveis de ambiente — copie para `.env` e preencha com valores reais.
# O arquivo `.env` NÃO deve ser commitado (está no .gitignore).
# =============================================================================

# ----- PostgreSQL (usado pelo docker-compose e pelo Rails) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
POSTGRES_DB=antecipe_development
POSTGRES_PORT=5432

# ----- Chaves dos agentes de IA -----
BROWSERBASE_API_KEY=
OPENCODE_API_KEY=
